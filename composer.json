{
  "name": "moloni/prestashop-on",
  "description": "Module for PrestaShop integration with Moloni ON",
  "type": "prestashop-module",
  "license": "OSL-3.0",
  "authors": [
    {
      "name": "Moloni",
      "email": "suporte@molonion.pt"
    }
  ],
  "scripts": {
    "check-phpstan": "php vendor/bin/phpstan analyse --configuration=tests/phpstan/phpstan.neon --memory-limit 10G",
    "auto-index": [
      "php -r \"copy('index.php', 'vendor/prestashop/autoindex/assets/index.php');\"",
      "php vendor/bin/autoindex prestashop:add:index --exclude=vendor/php-cs-fixer,vendor/friendsofphp"
    ],
    "auto-header": "php vendor/bin/header-stamp --license=.dev/assets/license.txt --exclude=composer.json,vendor,views,node_modules",
    "auto-phpcs": "vendor/bin/php-cs-fixer fix",
    "install-dev": "composer install",
    "install-prod": "composer install --no-dev --optimize-autoloader",
    "build": [
      "@auto-index",
      "@auto-header",
      "@auto-phpcs",
      "php builder.php"
    ]
  },
  "minimum-stability": "stable",
  "require-dev": {
    "prestashop/php-dev-tools": "v4.3.0",
    "phpstan/phpstan": "2.1.17",
    "friendsofphp/php-cs-fixer": "v3.75.0",
    "squizlabs/php_codesniffer": "3.13.2"
  },
  "config": {
    "preferred-install": "dist",
    "prepend-autoloader": false,
    "optimize-autoloader": true,
    "platform": {
      "php": "7.4"
    }
  },
  "autoload": {
    "psr-4": {
      "MoloniOn\\": "src/"
    }
  },
  "require": {
    "php": ">=7.2",
    "ext-curl": "*",
    "ext-json": "*"
  },
  "extra": []
}
