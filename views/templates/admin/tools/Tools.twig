{% extends view_dir ~ 'Layout.twig' %}

{% block plugin_content %}
    <div class="card">
        <h3 class="card-header">
            <i class="material-icons">plumbing</i>
            {{ 'Tools'|trans({}, 'Modules.Molonion.Tools') }}
        </h3>
        <div class="card-block">
            <div class="d-flex">
                <div class="ml-py-2">
                    <b>{{ 'Import products from Moloni ON'|trans({}, 'Modules.Molonion.Tools') }}</b>
                    <p class="small-text text-muted">
                        {{ "Use this tool to create all products from your Moloni ON account in your PrestaShop store."|trans({}, 'Modules.Molonion.Tools') }}
                    </p>
                </div>
                <div class="d-flex justify-content-center align-items-center ml-auto">
                    <button type="button"
                            class="btn btn-primary"
                            data-toggle="modal"
                            data-target="#import_products_modal">
                        {{ 'Import products to PrestaShop'|trans({}, 'Modules.Molonion.Tools') }}
                    </button>
                </div>
            </div>

            <div class="d-flex border-top">
                <div class="ml-py-2">
                    <b>{{ 'Export products to Moloni ON'|trans({}, 'Modules.Molonion.Tools') }}</b>
                    <p class="small-text text-muted">
                        {{ "Use this tool to create all products in your PrestaShop store account in your Moloni ON account."|trans({}, 'Modules.Molonion.Tools') }}
                    </p>
                </div>
                <div class="d-flex justify-content-center align-items-center ml-auto">
                    <button type="button"
                            class="btn btn-primary"
                            data-toggle="modal"
                            data-target="#export_products_modal">
                        {{ 'Export products to Moloni ON'|trans({}, 'Modules.Molonion.Tools') }}
                    </button>
                </div>
            </div>

            {% if company.canSyncStock %}
            <div class="d-flex border-top">
                <div class="ml-py-2">
                    <b>{{ 'Synchronize PrestaShop stocks with Moloni ON'|trans({}, 'Modules.Molonion.Tools') }}</b>
                    <p class="small-text text-muted">
                        {{ "This tool searches for all products updated in your Moloni ON account in the last seven days and updates the corresponding product inventory in PrestaShop."|trans({}, 'Modules.Molonion.Tools') }}
                    </p>
                </div>
                <div class="d-flex justify-content-center align-items-center ml-auto">
                    <button type="button"
                            class="btn btn-primary"
                            data-toggle="modal"
                            data-target="#import_stocks_modal">
                        {{ 'Update PrestaShop stocks'|trans({}, 'Modules.Molonion.Tools') }}
                    </button>
                </div>
            </div>
            {% endif %}

            {% if company.canSyncStock %}
            <div class="d-flex border-top">
                <div class="ml-py-2">
                    <b>{{ 'Synchronize Moloni ON stocks with PrestaShop'|trans({}, 'Modules.Molonion.Tools') }}</b>
                    <p class="small-text text-muted">
                        {{ "This tool will search for all the products in your PrestaShop store and update the matching products in your Moloni ON account."|trans({}, 'Modules.Molonion.Tools') }}
                    </p>
                </div>
                <div class="d-flex justify-content-center align-items-center ml-auto">
                    <button type="button"
                            class="btn btn-primary"
                            data-toggle="modal"
                            data-target="#export_stocks_modal">
                        {{ 'Update Moloni ON stocks'|trans({}, 'Modules.Molonion.Tools') }}
                    </button>
                </div>
            </div>
            {% endif %}

            {% if company.hasWebhooks %}
            <div class="d-flex border-top">
                <div class="ml-py-2">
                    <b>{{ 'Reinstall webhooks'|trans({}, 'Modules.Molonion.Tools') }}</b>
                    <p class="small-text text-muted">
                        {{ "This tool recreates the Moloni ON synchronization webhooks."|trans({}, 'Modules.Molonion.Tools') }}<br>
                        {{ "You should perform this action if the store URL changes or if the PrestaShop module access tokens are updated."|trans({}, 'Modules.Molonion.Tools') }}
                    </p>
                </div>
                <div class="d-flex justify-content-center align-items-center ml-auto">
                    <a class="btn btn-primary" href="{{ path(reinstallHooksRoute) }}">
                        {{ 'Reinstall webhooks'|trans({}, 'Modules.Molonion.Tools') }}
                    </a>
                </div>
            </div>
            {% endif %}

            <div class="d-flex border-top">
                <div class="ml-py-2">
                    <b>{{ "List PrestaShop products"|trans({}, 'Modules.Molonion.Tools') }}</b>

                    <p class="small-text text-muted">
                        {{ "List all PrestaShop products and the corresponding Moloni ON product."|trans({}, 'Modules.Molonion.Tools') }}<br>
                        {{ "This page allow to verify if the product stock are updated, if they exist in Moloni ON or if there are some problems."|trans({}, 'Modules.Molonion.Tools') }}
                    </p>
                </div>
                <div class="d-flex justify-content-center align-items-center ml-auto">
                    <a class="btn btn-primary" href="{{ path(productsPrestashopRoutes) }}">
                        {{ 'View PrestaShop products'|trans({}, 'Modules.Molonion.Tools') }}
                    </a>
                </div>
            </div>

            <div class="d-flex border-top">
                <div class="ml-py-2">
                    <b>{{ "List Moloni ON products"|trans({}, 'Modules.Molonion.Tools') }}</b>

                    <p class="small-text text-muted">
                        {{ "List all Moloni ON products and the corresponding PrestaShop product."|trans({}, 'Modules.Molonion.Tools') }}<br>
                        {{ "This page allow to verify if the product stock are updated, if they exist in PrestaShop or if there are some problems."|trans({}, 'Modules.Molonion.Tools') }}
                    </p>
                </div>
                <div class="d-flex justify-content-center align-items-center ml-auto">
                    <a class="btn btn-primary" href="{{ path(productsMoloniRoutes) }}">
                        {{ 'View Moloni ON products'|trans({}, 'Modules.Molonion.Tools') }}
                    </a>
                </div>
            </div>

            <div class="d-flex border-top">
                <div class="ml-py-2">
                    <b>{{ "Logout"|trans({}, 'Modules.Molonion.Tools') }}</b>
                    <p class="small-text text-muted">
                        {{ "Logout from the selected Moloni ON account. We will keep all the data regarding issued documents."|trans({}, 'Modules.Molonion.Tools') }}
                    </p>
                </div>
                <div class="d-flex justify-content-center align-items-center ml-auto">
                    <button type="button"
                            class="btn btn-danger"
                            data-toggle="modal"
                            data-target="#logout_modal">
                        {{ 'Logout'|trans({}, 'Modules.Molonion.Tools') }}
                    </button>
                </div>
            </div>
        </div>
    </div>

    {# Import products Overlay #}
    {% include view_dir ~ 'tools/overlays/ProductImport.twig' %}

    {# Import stocks Overlay #}
    {% include view_dir ~ 'tools/overlays/StocksImport.twig' %}

    {# Export products Overlay #}
    {% include view_dir ~ 'tools/overlays/ProductExport.twig' %}

    {# Export stocks Overlay #}
    {% include view_dir ~ 'tools/overlays/StocksExport.twig' %}

    {# Logout Overlay #}
    {% include view_dir ~ 'tools/overlays/Logout.twig' %}

    {# Action Overlay #}
    {% include view_dir ~ 'tools/overlays/ActionOverlay.twig' %}
{% endblock %}

{% block javascripts %}
    <script>
        $(document).ready(function () {
            let props = {
                importProductsAction: "{{ path(importProductsRoute) }}",
                importStocksAction: "{{ path(importStocksRoute) }}",
                exportProductsAction: "{{ path(exportProductsRoute) }}",
                exportStocksAction: "{{ path(exportStocksRoute) }}"
            };

            window.molonion.Tools.startObservers(props);
        });
    </script>
{% endblock %}
