{% extends '@PrestaShop/Admin/layout.html.twig' %}

{% block content %}
    {% block plugin_content %}{% endblock %}

    <div class="d-flex flex-column align-items-center">
        {% if (companyName is defined) and  (companyName is not empty) %}
            <b>
                {{ companyName }}
            </b>
        {% endif %}

        <p>
            {{ 'Need help?'|trans({}, 'Modules.Molonion.Common') }}
            <a href="{{ configs.help_page }}" target="_blank">
                {{ 'Take a look at our FAQ section.'|trans({}, 'Modules.Molonion.Common') }}
            </a>
        </p>
    </div>
{% endblock %}
